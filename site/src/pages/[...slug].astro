---
import DocLayout from '../layouts/DocLayout.astro';
import PageActions from '../components/PageActions.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const collections = ['ubiquitous-language', 'formal-laws'] as const;
  const paths = [];

  for (const name of collections) {
    const entries = await getCollection(name);
    for (const entry of entries) {
      const isIndexEntry = entry.id === 'index' || entry.id === '' || entry.id === name;
      const slug = isIndexEntry ? name : `${name}/${entry.id}`;

      paths.push({
        params: { slug },
        props: { entry, collection: name, isIndexEntry },
      });
    }
  }

  return paths;
}

const { entry, collection, isIndexEntry } = Astro.props;
const { Content, headings } = await render(entry);

const rawUrl = isIndexEntry
  ? `/${collection}/index.md`
  : `/${collection}/${entry.id}.md`;
---

<DocLayout title={entry.data.title} headings={headings}>
  <header class="mb-8 border-b border-border pb-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          {entry.data.title}
        </h1>
        {entry.data.section && (
          <p class="mt-2 text-sm text-text-muted">
            DDD sections {entry.data.section}
          </p>
        )}
      </div>

      <PageActions title={entry.data.title} rawUrl={rawUrl} />
    </div>
  </header>

  <article class="prose prose-docs">
    <Content />
  </article>
</DocLayout>
