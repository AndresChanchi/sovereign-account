---
import '../styles/globals.css';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, headings = [] } = Astro.props;
const hasToc = headings.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Sovereign Account</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-background text-text">
    <header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur">
      <div class="container-page flex h-14 items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="mobile-menu-toggle"
            class="icon-btn lg:hidden"
            aria-label="Open navigation"
            aria-controls="mobile-drawer"
            aria-expanded="false"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="18" x2="20" y2="18" />
            </svg>
          </button>

          <a href="/" class="flex items-center gap-2 font-semibold">
            <span class="inline-block h-6 w-6 rounded bg-primary"></span>
            <span>Sovereign Account</span>
          </a>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="https://github.com/AndresChanchi/sovereign-account"
            class="icon-btn"
            aria-label="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
            </svg>
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <!-- Mobile drawer -->
    <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
      <div class="mobile-drawer-backdrop" data-drawer-close></div>
      <aside class="mobile-drawer-panel" aria-label="Mobile navigation">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">
            Navigation
          </span>
          <button
            type="button"
            class="icon-btn"
            aria-label="Close navigation"
            data-drawer-close
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <Sidebar />

        {hasToc && (
          <div class="mt-6 border-t border-border pt-4">
            <Toc headings={headings} />
          </div>
        )}
      </aside>
    </div>

    <!-- Desktop layout -->
    <div class="container-page grid grid-cols-1 lg:grid-cols-[var(--spacing-sidebar)_1fr_var(--spacing-toc)] gap-8 py-8">
      <aside class="hidden lg:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
          <Sidebar />
        </div>
      </aside>

      <main class="min-w-0">
        <slot />
      </main>

      <aside class="hidden xl:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>

    <script is:inline>
      (function () {
        var toggle = document.getElementById('mobile-menu-toggle');
        var drawer = document.getElementById('mobile-drawer');
        if (!toggle || !drawer) return;

        function open() {
          drawer.setAttribute('data-open', 'true');
          drawer.setAttribute('aria-hidden', 'false');
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function close() {
          drawer.setAttribute('data-open', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        toggle.addEventListener('click', function () {
          if (drawer.getAttribute('data-open') === 'true') close();
          else open();
        });

        drawer.querySelectorAll('[data-drawer-close]').forEach(function (el) {
          el.addEventListener('click', close);
        });

        drawer.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('a')) close();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.getAttribute('data-open') === 'true') close();
        });

        window.addEventListener('resize', function () {
          if (window.innerWidth >= 1024 && drawer.getAttribute('data-open') === 'true') close();
        });
      })();
    </script>
  </body>
</html>
